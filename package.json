{
  "name": "quatr-elkhan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "bun run --parallel dev:server dev:client",
    "dev:server": "bun --watch src/server/index.ts",
    "dev:client": "vite",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "format": "biome check --write .",
    "check:unused": "knip",
    "test:unit": "vitest run --project unit && vitest run --project ui",
    "test:integration": "vitest run --project integration",
    "test": "bun run test:unit && bun run test:integration",
    "build": "bun run typecheck && vite build && bun build src/server/index.ts --target=bun --packages=external --outdir=dist/server",
    "start": "NODE_ENV=production bun dist/server/index.js"
  },
  "dependencies": {
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "jsdom": "30.0.1",
    "knip": "6.35.1",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
